{
  "name": "flux",
  "productName": "Flux",
  "version": "0.1.3",
  "description": "Flux – szybka, lekka i prywatna przeglądarka internetowa",
  "author": {
    "name": "Kitsun3 Kage",
    "email": "kontakt@kitsun3kage.github.io"
  },
  "license": "MIT",
  "homepage": "https://kitsun3kage.github.io/Flux/",
  "repository": {
    "type": "git",
    "url": "https://github.com/kitsun3kage/Flux.git"
  },
  "bugs": {
    "url": "https://github.com/kitsun3kage/Flux/issues"
  },
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --enable-logging",
    "build": "electron-builder --mac",
    "build:win": "electron-builder --win",
    "build:linux": "electron-builder --linux",
    "build:all": "electron-builder --mac --win --linux",
    "release": "electron-builder --mac --win --linux --publish always"
  },
  "protocols": [
    {
      "name": "Web Browser",
      "schemes": ["http", "https"]
    },
    {
      "name": "Flux Protocol",
      "schemes": ["flux"]
    }
  ],
  "dependencies": {
    "electron-updater": "^6.3.9"
  },
  "devDependencies": {
    "electron": "^32.3.3",
    "electron-builder": "^26.15.3"
  },
  "build": {
    "appId": "com.kitsun3kage.flux",
    "productName": "Flux",
    "copyright": "Copyright © 2026 Kitsun3 Kage",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "**/*",
      "!dist/**",
      "!*.md",
      "!.github/**",
      "!.vscode/**",
      "!.gitignore"
    ],
    "mac": {
      "category": "public.app-category.productivity",
      "target": [
        { "target": "dmg", "arch": ["arm64", "x64"] },
        { "target": "zip", "arch": ["arm64", "x64"] }
      ],
      "icon": "build/icon.png",
      "hardenedRuntime": true,
      "gatekeeperAssess": false,
      "entitlements": "entitlements.mac.plist",
      "entitlementsInherit": "entitlements.mac.inherit.plist"
    },
    "dmg": {
      "title": "Flux ${version}",
      "contents": [
        { "x": 130, "y": 220 },
        { "x": 410, "y": 220, "type": "link", "path": "/Applications" }
      ]
    },
    "win": {
      "target": [
        { "target": "nsis", "arch": ["x64"] }
      ],
      "icon": "build/icon.png"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Flux"
    },
    "linux": {
      "target": ["AppImage", "deb"],
      "icon": "build/icon.png",
      "category": "Network",
      "maintainer": "Kitsun3 Kage <kontakt@kitsun3kage.github.io>"
    },
    "publish": {
      "provider": "github",
      "owner": "kitsun3kage",
      "repo": "Flux",
      "releaseType": "release"
    }
  }
}